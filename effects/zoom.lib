// effects/zoom.lib
//
// Shared Standard-FAUST DSP Helper Library for Zoom MS Plus Pedals (44.1 kHz).
// Import inside any effect `.dsp` file using standard Faust syntax:
//   import("stdfaust.lib");
//   import("zoom.lib");
//
// All definitions in this file are composed strictly of standard Faust
// operators and official `stdfaust.lib` primitives (`fi.*`, `si.*`, `de.*`,
// `ba.*`, `ma.*`, `aa.*`, `no.*`) so they work identically with both the
// official `faust` compiler (`faust -I effects/`) and `tools/faust2zd2.py`.

// ---- 1. Fast 1-Pole Filters & Smoothers (`fi.*` / `si.*`) ----

// 1-pole EMA smoother with direct alpha coefficient `a` in (0, 1):
//   y[n] = y[n-1] + a * (x[n] - y[n-1]) = (1 - a) * y[n-1] + a * x[n]
// Expressed in standard Faust via `si.smooth(1.0 - a)`.
zm_ema(a, x) = si.smooth(1.0 - a, x);

// 1st-order all-pass phase disperser:
//   H(z) = (g + z^-1) / (1 + g * z^-1)
// Expressed in standard Faust via `fi.tf1(g, 1.0, g, x)`.
zm_allpass1(g, x) = fi.tf1(g, 1.0, g, x);

// ---- 2. Saturators & Quantizers (Calibrated for Zoom -18 dBFS / 0.25 RMS Bus) ----

// C^1-continuous cubic soft clipper on [-1.5, +1.5] -> [-1.0, +1.0]:
//   f(x) = x - (4/27) * x^3  (zero slope at +-1.5, unity slope at 0)
zm_soft_clip(x) = xc - 0.14814815 * xc * xc * xc
    with {
        xc = aa.clip(-1.5, 1.5, x);
    };

// 12-bit signed PCM rack DAC quantizer (-2048..+2048 steps, Boss SE-50 style;
// uses fast SPTRUNC+INTSP truncation, matching zm_sat16, with dither pre-applied)
zm_quant12(s) = int(s * 2048.0) * 0.00048828125;

// 16-bit signed fixed-point accumulator saturator (Sony PS1 SPU style)
zm_sat16(x) = int(zm_soft_clip(x) * 16384.0) * 0.00006103515625;

// ---- 3. Grain Windowing & Phase Accumulators ----

// 20% smoothstep Tukey grain crossfade window on normalized phase `p` in [0, 1):
//   - p in [0.00, 0.20): cubic Hermite fade-in  3t^2 - 2t^3  (t = 5*p)
//   - p in [0.20, 0.50): 1.0 (Tap A solo)
//   - p in [0.50, 0.70): cubic Hermite fade-out 1 - (3t^2 - 2t^3)
//   - p in [0.70, 1.00): 0.0 (Tap B solo)
// Expressed branchlessly via symmetry around p = 0.35 so cl6x can software-pipeline
// grain loops without conditional branches.
zm_tukey20(p) = u * u * (3.0 - 2.0 * u)
    with {
        u = aa.clip(0.0, 1.0, (0.35 - abs(p - 0.35)) * 5.0);
    };

// ---- 4. Zoom MS Plus SDRAM Delay Line Helpers (4096-Sample Ring Buffer) ----
//
// Standard-Faust wrappers around `de.delay`, `de.fdelay1`, `de.fdelay2`, and
// `de.fdelay3` pre-sized to the hardware-verified 4096-float (~92.9 ms @ 44.1 kHz)
// power-of-two SDRAM ring buffer (`instance[3]`).
//
// Multiple calls to `zm_delay` / `zm_fdelay*` on the same signal `x` automatically
// share a single underlying 4096-float SDRAM ring buffer (`dline_k`) per channel
// with a `+16`-float (+64 B) L1D cache-set skew stride.
//
// Interpolation cost vs. quality on C674x (no libm, 16-bit EMIFB SDRAM bus):
//   - `zm_delay(d, x)`   : 1-tap integer delay (`de.delay(4096, d, x)` -> `sh_dread_i`).
//                          Use for fixed comb/reverb taps or static pre-delays.
//   - `zm_fdelay(d, x)`  /
//     `zm_fdelay1(d, x)` : 2-point (1st-order) linear Lagrange interpolation
//                          (`de.fdelay1(4096, d, x)` -> `sh_dread_1`).
//                          Use for multi-grain pitch shifters (4-8 moving taps/frame)
//                          or vintage digital rack emulations (Boss SE-50).
//   - `zm_fdelay2(d, x)` : 3-point (2nd-order) quadratic Lagrange interpolation
//                          (`de.fdelay2(4096, d, x)` -> `sh_dread_2`).
//   - `zm_fdelay3(d, x)` : 4-point (3rd-order) cubic Lagrange interpolation
//                          (`de.fdelay3(4096, d, x)` -> `sh_dread_3`).
//                          Use for 1-2 swept Chorus / Through-Zero Flanger taps.
zm_delay(d, x)   = de.delay(4096, d, x);
zm_fdelay(d, x)  = de.fdelay(4096, d, x);
zm_fdelay1(d, x) = de.fdelay1(4096, d, x);
zm_fdelay2(d, x) = de.fdelay2(4096, d, x);
zm_fdelay3(d, x) = de.fdelay3(4096, d, x);

// ---- 5. Pedal Footswitch / Bypass State Helpers ----
// Evaluate to 1.0 in standard desktop FAUST compilers; in `tools/faust2zd2.py`
// map directly to hardware bypass crossfade (`fade >= 0.05f`) and trailing
// `ON/OFF` mode (`LATCH` = 0.0, `UNLATCH` = 1.0).
zm_fsw_active = 1.0;
zm_is_unlatch = 1.0;

// Pedal global BPM (Tap Tempo / host BPM module). Evaluates to 120.0 in
// standard desktop FAUST compilers; in `zoom-faust-fx` maps directly to
// `coef[SH_COEFF_BPM]` (populated from host `ctx[34](7, 4000)` on hardware
// and from the toolbar BPM / Tap Tempo in the WebAssembly auditioner).
zm_bpm = 120.0;

// Convert a beat-subdivision multiplier (0.25=1/16, 0.5=1/8, 0.75=1/8., 1.0=1/4, 1.5=1/4.)
// to delay time in milliseconds using the pedal's live global BPM, clamped to `max_ms`.
zm_bpm_ms(beats, max_ms) = min(max_ms, (60000.0 / zm_bpm) * beats);

// Single-knob official Zoom-style Time parameter (`[time_sync:min_ms..max_ms]`):
//   - clicks `0 .. (max_ms - min_ms)`: direct milliseconds (`min_ms .. max_ms`)
//   - clicks `(max_ms - min_ms + 1) .. (+7)`: note subdivisions synced to `bpm` (`zm_bpm`)
//     (1/16, 1/8T, 1/8, 1/4T, 1/8., 1/4, 1/4.)
zm_time_sync_ms(raw_click, min_ms, max_ms, bpm) =
    ba.if(raw_click <= ms_max_click + 0.5, free_ms, note_ms)
    with {
        ms_max_click = max_ms - min_ms;
        free_ms      = min_ms + raw_click;
        note_idx     = int(min(6.0, max(0.0, floor(raw_click - ms_max_click - 0.5))));
        beats        = ba.if(note_idx < 0.5, 0.25,
                       ba.if(note_idx < 1.5, 0.3333333,
                       ba.if(note_idx < 2.5, 0.5,
                       ba.if(note_idx < 3.5, 0.6666667,
                       ba.if(note_idx < 4.5, 0.75,
                       ba.if(note_idx < 5.5, 1.0, 1.5))))));
        note_ms      = min(max_ms, (60000.0 / bpm) * beats);
    };

// ---- 6. Standard-Faust Compatibility & Zoom-Sized DSP Algorithms ----

// Convert milliseconds to samples at ma.SR (standard Faust replacement for ba.ms2samp)
zm_ms2samp(ms) = ms * 0.001 * ma.SR;

// Chamberlin / SVF wrappers compatible with standard Faust (fi.svf.*)
zm_svf_lp(fc, q, x)   = fi.svf.lp(fc, q, x);
zm_svf_hp(fc, q, x)   = fi.svf.hp(fc, q, x);
zm_svf_peak(fc, q, x) = fi.svf.peak(fc, q, x);

// Wavetable-free sine/cosine oscillators & stock-style Q31 LFOs (0 KB SDRAM).
// In standard desktop/WASM FAUST these expand directly to `os.*` primitives;
// in `zoom-faust-fx` C674x builds they lower into a stock-style two-loop Q31
// LFO generator (Loop 1 streaming `ctx[9..10]`, Loop 2 audio) with zero LUTs
// and automatic phase sharing across LFOs driven by the same `rate` signal.
zm_lf_sawpos(f)          = os.lf_sawpos(f);
zm_lf_sawpos_phase(f, p) = os.lf_sawpos_phase(f, p);
zm_lf_saw(f)             = os.lf_saw(f);
zm_lf_trianglepos(f)     = os.lf_trianglepos(f);
zm_lf_triangle(f)        = os.lf_triangle(f);
zm_lf_squarewavepos(f)   = os.lf_squarewavepos(f);
zm_lf_squarewave(f)      = os.lf_squarewave(f);
zm_osc(f)                = sin(2.0 * ma.PI * os.phasor(1.0, f));
zm_osccos(f)             = cos(2.0 * ma.PI * os.phasor(1.0, f));
zm_oscp(f, p)            = sin(2.0 * ma.PI * os.phasor(1.0, f) + p);
zm_quadosc(f)            = zm_osc(f), zm_osccos(f);
zm_triosc(f)             = zm_oscp(f, 0.0), zm_oscp(f, 2.0943951), zm_oscp(f, 4.1887902);
zm_osc_spread(f, spread) = zm_osc(f), zm_oscp(f, spread * ma.PI);
zm_quad4(f)              = s, c, 0.0 - s, 0.0 - c with { s = zm_osc(f); c = zm_osccos(f); };
zm_lf_sh(f)              = no.noise : ba.latch(os.lf_imptrain(f));

// Single-knob Zoom-style LFO Rate parameter (`[lfo_sync:min_hz..max_hz]` or `[zoom:lfo_sync]`):
//   - clicks `0 .. hz_max_click`: free-running Hz (`min_hz .. max_hz` in `step_hz` increments)
//   - upper clicks: BPM-synced note subdivisions (1/32, 1/16, 1/8T, 1/16., 1/8, 1/4T, 1/8., 1/4, 1/4., 1/2)
zm_lfo_sync_hz(raw_click, min_hz, max_hz, step_hz, bpm) =
    ba.if(raw_click <= hz_max_click + 0.5, free_hz, note_hz)
    with {
        hz_max_click = (max_hz - min_hz) / step_hz;
        free_hz      = min_hz + raw_click * step_hz;
        note_idx     = int(min(9.0, max(0.0, floor(raw_click - hz_max_click - 0.5))));
        beats        = ba.if(note_idx < 0.5, 0.125,
                       ba.if(note_idx < 1.5, 0.25,
                       ba.if(note_idx < 2.5, 0.3333333,
                       ba.if(note_idx < 3.5, 0.375,
                       ba.if(note_idx < 4.5, 0.5,
                       ba.if(note_idx < 5.5, 0.6666667,
                       ba.if(note_idx < 6.5, 0.75,
                       ba.if(note_idx < 7.5, 1.0,
                       ba.if(note_idx < 8.5, 1.5, 2.0)))))))));
        note_hz      = bpm / (60.0 * beats);
    };

// Zoom-sized stereo Schroeder/Freeverb-style reverb (fits < 529 KB SDRAM & C674x budget).
// Parameters: room in [0, 1], damp in [0, 1], width in [0, 1] (unused/reserved).
zm_freeverb(room, damp, width, l, r) = tankL(l), tankR(r)
    with {
        g = min(0.92, 0.55 + room * 0.35);
        d = aa.clip(0.05, 0.90, damp);
        comb(n, x) = (+(x) : de.delay(2048, n) : *(1.0 - d) + (*(d) ~ _)) ~ *(g);
        apf(n, x)  = fi.allpass_comb(1024, n, 0.5, x);
        tankL(x) = (comb(1116, x) + comb(1188, x) + comb(1277, x) + comb(1356, x)) * 0.25
                 : apf(225, _) : apf(556, _);
        tankR(x) = (comb(1139, x) + comb(1211, x) + comb(1300, x) + comb(1379, x)) * 0.25
                 : apf(248, _) : apf(579, _);
    };
